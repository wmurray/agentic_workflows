# jira-toolkit config — copy to jira.env (gitignored) and fill in. Sourced by env.sh.
# Field and transition ids: GET $JIRA_BASE/rest/api/3/field  and
#                           GET $JIRA_BASE/rest/api/3/issue/<KEY>/transitions

# --- connection ---------------------------------------------------------------------------
JIRA_BASE="https://your-org.atlassian.net"
JIRA_LOGIN="you@your-org.com"        # basic-auth user for REST calls
# JIRA_API_TOKEN=                    # usually exported by your shell; may live here instead

# --- ticket keys ---------------------------------------------------------------------------
JIRA_KEY_REGEX="[A-Z][A-Z0-9]+-[0-9]+" # what a ticket key looks like; narrow to "ABC-[0-9]+" for one project

# --- status names (as your workflow spells them) ----------------------------------------
JIRA_STATUS_READY="Selected for Development"   # refined, ready to be picked up
JIRA_STATUS_IN_PROGRESS="In Progress"
JIRA_STATUS_CODE_REVIEW="Code Review"
JIRA_STATUS_PRODUCT_REVIEW="Product Review"
JIRA_STATUS_QA="QA Review"
JIRA_STATUS_DONE="Done"

# --- transitions the CLI cannot drive by name (need REST + required screen fields) -------
JIRA_TRANSITION_QA_ID="12"           # → $JIRA_STATUS_QA
JIRA_TRANSITION_DONE_ID="6"          # → $JIRA_STATUS_DONE; requires resolution + release note
JIRA_DONE_RESOLUTION="Done"

# --- custom fields --------------------------------------------------------------------------
JIRA_FIELD_RELEASE_NOTE="customfield_XXXXX"    # rich text (written as ADF)
JIRA_FIELD_TESTING_NOTES="customfield_XXXXX"   # rich text (written as ADF)
JIRA_FIELD_FEATURE_FLAGS="customfield_XXXXX"   # labels field (array of tokens)

# --- assignment ----------------------------------------------------------------------------
JIRA_ASSIGNEE_DEFAULT="you@your-org.com"       # what `jira issue assign` receives
JIRA_ASSIGNEE_DEFAULT_ID=""                    # optional Atlassian accountId for an exact match

# --- GitHub side ---------------------------------------------------------------------------
GH_REVIEW_TEAM="your-org/your-team"            # default reviewer team for request-review.sh
GH_OUTSIDE_SPRINT_LABEL="outside current sprint"
GH_BLOCK_LABELS="do not merge,dont merge,do-not-merge,dnm,hold,wip"   # any present → merge refused
GH_MERGE_METHOD="squash"
GH_FREEZE_CHECK_PATTERN="freeze"               # a red CI check matching this = sprint freeze gate
DEPENDABOT_ALLOWED_PATHS='^(package\.json|yarn\.lock|package-lock\.json|Gemfile|Gemfile\.lock)$'
