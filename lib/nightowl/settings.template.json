{
  "_nightowl": "Per-pane permission profile for one nightowl task. nightowl.sh fills the {{PLACEHOLDERS}}, appends the _nightowl_kinds entry for the task's kind (and _nightowl_notes for research when NIGHTOWL_NOTES_DIR is set), adds NIGHTOWL_DENY_* and NIGHTOWL_ALLOW_EXTRA, then drops every _nightowl key. Deny wins over allow in every settings source, so the deny list is the hard boundary; the allow list only decides what runs without a prompt. A path rule starting with a single / here becomes //absolute once the path is filled in.",
  "sandbox": { "enabled": false },
  "env": {
    "NIGHTOWL_DATE": "{{DATE}}",
    "NIGHTOWL_TASK": "{{ID}}"
  },
  "permissions": {
    "defaultMode": "{{MODE}}",
    "additionalDirectories": ["{{TASK_DIR}}"],
    "allow": [
      "Read(/{{WORKTREE}}/**)",
      "Edit(/{{WORKTREE}}/**)",
      "Write(/{{WORKTREE}}/**)",
      "Read(/{{TASK_DIR}}/**)",
      "Edit(/{{TASK_DIR}}/**)",
      "Write(/{{TASK_DIR}}/**)",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git grep*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git branch --show-current)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh issue view*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(mkdir *)",
      "Bash({{NIGHTOWL}} finish --date {{DATE}} {{ID}}*)"
    ],
    "deny": [
      "Bash(op)",
      "Bash(op *)",
      "Bash(sentry-cli)",
      "Bash(sentry-cli *)",
      "Bash(kubectl)",
      "Bash(kubectl *)",
      "Bash(aws *)",
      "Bash(aws)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(security *)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(gh pr merge*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr review*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr close*)",
      "Bash(gh pr create*)",
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh release*)",
      "Bash(gh workflow*)",
      "Bash(gh run rerun*)",
      "Bash(gh run cancel*)",
      "Bash(gh repo*)",
      "Bash(gh auth*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh api*-X*)",
      "Bash(gh api*--method*)",
      "Bash(gh api*-f *)",
      "Bash(gh api*-F *)",
      "Bash(gh api*--field*)",
      "Bash(gh api*--raw-field*)",
      "Bash(gh api*--input*)",
      "Bash(gh api graphql*)",
      "Bash(git push*)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(git branch -D*)",
      "Bash(git config --global*)",
      "Bash(*merge.sh*)",
      "Bash(*jira-status.sh*)",
      "Bash(*qa-transition.sh*)",
      "Bash(*done-transition.sh*)",
      "Bash(*assign.sh*)",
      "Bash(*request-review.sh*)",
      "Bash(*release-note.sh*)",
      "Bash(*feature-flags.sh*)",
      "Bash(*testing-notes.sh*)",
      "Bash(*sprint-add.sh*)",
      "Bash(mc *)",
      "Bash(jira issue move*)",
      "Bash(jira issue comment*)",
      "Bash(jira issue edit*)",
      "Bash(jira issue assign*)",
      "Bash(jira issue create*)",
      "Bash(acli jira workitem transition*)",
      "Bash(acli jira workitem comment*)",
      "Bash(acli jira workitem edit*)",
      "Bash(acli jira workitem assign*)",
      "Bash(acli jira workitem create*)",
      "mcp__claude_ai_Atlassian__transitionJiraIssue",
      "mcp__claude_ai_Atlassian__addCommentToJiraIssue",
      "mcp__claude_ai_Atlassian__editJiraIssue",
      "mcp__claude_ai_Atlassian__createJiraIssue",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/op/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(~/.claude/settings*.json)",
      "Write(~/.claude/settings*.json)",
      "Edit(/{{MC_HOME}}/**)",
      "Write(/{{MC_HOME}}/**)",
      "Edit(/{{LIB}}/**)",
      "Write(/{{LIB}}/**)",
      "Edit(/{{REVIEW_TOOLKIT}}/**)",
      "Write(/{{REVIEW_TOOLKIT}}/**)",
      "Edit(/{{REPORT_DIR}}/*.json)",
      "Write(/{{REPORT_DIR}}/*.json)",
      "Edit(/{{REPORT_DIR}}/*.md)",
      "Write(/{{REPORT_DIR}}/*.md)",
      "Edit(/{{TASK_DIR}}/settings*.json)",
      "Write(/{{TASK_DIR}}/settings*.json)"
    ]
  },
  "_nightowl_kinds": {
    "plan": { "allow": [] },
    "repro": { "allow": [] },
    "draft-pr": {
      "allow": [
        "Bash({{NIGHTOWL}} push --date {{DATE}} {{ID}}*)",
        "Bash({{NIGHTOWL}} draft-pr --date {{DATE}} {{ID}}*)",
        "Bash({{REVIEW_TOOLKIT}}/review-reply.sh *)"
      ]
    },
    "flake": {
      "allow": [
        "Bash({{NIGHTOWL}} push --date {{DATE}} {{ID}}*)",
        "Bash({{NIGHTOWL}} draft-pr --date {{DATE}} {{ID}}*)"
      ]
    },
    "review": {
      "allow": [
        "Bash({{NIGHTOWL}} pending-review --date {{DATE}} {{ID}}*)",
        "Bash({{REVIEW_TOOLKIT}}/review-post.sh *)"
      ]
    },
    "research": { "allow": ["WebSearch", "WebFetch"] }
  },
  "_nightowl_notes": {
    "kinds": ["research"],
    "additionalDirectories": ["{{NOTES_DIR}}"],
    "allow": ["Read(/{{NOTES_DIR}}/**)", "Edit(/{{NOTES_DIR}}/**)", "Write(/{{NOTES_DIR}}/**)"]
  }
}
