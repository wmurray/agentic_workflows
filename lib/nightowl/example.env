# nightowl.env: your local values for lib/nightowl/nightowl.sh. Copy this file to
# lib/nightowl/nightowl.env (gitignored) or point NIGHTOWL_ENV at a copy elsewhere.
# A variable already set in the environment wins over this file.

# Where the night's manifest, report and per-task files live. Keep it out of ~/.claude:
# Claude Code protects that tree, so a dontAsk pane cannot write its result.json there.
# NIGHTOWL_REPORT_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nightowl"

# A notes folder research tasks may write into. Empty means none: research stays in the
# report.
# NIGHTOWL_NOTES_DIR=""

# Installed library sources every pane may read but never edit, comma separated: a gem
# home, a language's site-packages. Panes can already grep these from Bash; this lets the
# Read tool open them. Never list a directory that holds credentials.
# NIGHTOWL_LIBRARY_DIRS="$HOME/.local/share/mise/installs/ruby/3.4.2/lib/ruby/gems/3.4.0/gems"

# Extra allow rules for research tasks only, comma separated, in Claude Code rule syntax.
# Use it for a docs or notes tool research should write through, e.g. an MCP server.
# NIGHTOWL_RESEARCH_ALLOW=""

# Extra commands every pane is denied, comma separated. Put your metrics/APM and
# error-tracker CLIs here. Each name is denied bare and with arguments.
# NIGHTOWL_DENY_EXTRA="curl, wget"

# Deploy CLIs, denied the same way.
# NIGHTOWL_DENY_DEPLOY="terraform, pulumi, heroku, flyctl, vercel, netlify, gcloud, az"

# Extra allow rules every pane gets, comma separated, in Claude Code rule syntax. This is
# where test runners go so a task can run its suite without a prompt.
# If an rtk PreToolUse hook rewrites commands on this machine, list the rewritten form too:
# `rtk rewrite "<cmd>"` prints it (npx tsc becomes rtk tsc).
# NIGHTOWL_ALLOW_EXTRA="Bash(npm test*), Bash(bundle exec rspec*), Bash(rtk rspec*)"

# Branch prefixes a task may push to. A push or draft-pr task must name a branch under one
# of these; anything else is refused at confirm and again at push.
# NIGHTOWL_BRANCH_PREFIXES="nightowl/"

# Permission mode for the panes. dontAsk denies anything not allowed instead of waiting on
# a prompt nobody will answer before morning.
# NIGHTOWL_PERMISSION_MODE="dontAsk"

# The pane runner and the herdr workspace the panes open in.
# NIGHTOWL_RUNNER="<repo>/lib/mission-control/adapters/runner/herdr.sh"
# NIGHTOWL_WORKSPACE="$MC_HERDR_WS_BACKGROUND"
# NIGHTOWL_MODEL=""

# Work log and review-toolkit locations, defaulting to the copies in this repo.
# NIGHTOWL_WORKLOG="<repo>/lib/mission-control/worklog.sh"
# NIGHTOWL_REVIEW_TOOLKIT="<repo>/lib/review-toolkit"

# The private leak denylist the push op checks a .mc-leak-guard repo against. Falls back to
# MC_DENYLIST, the pre-commit scanner's variable.
# NIGHTOWL_LEAK_DENYLIST="$HOME/.claude/mc-leak-denylist.txt"

# Most tasks one night may run.
# NIGHTOWL_MAX_TASKS=4

# Optional worktree helper, for repos that need more than `git worktree add` (a test
# database, installed dependencies). It runs instead of the default with NO_REPO,
# NO_WORKTREE, NO_BRANCH, NO_BASE, NO_KIND and NO_PUSH in its environment and must leave
# a checkout at NO_WORKTREE.
# NIGHTOWL_WORKTREE_CMD=""
