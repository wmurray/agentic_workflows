# fixture.env — the profile that points the engine at the file-backed adapters.
#
# COMMITTED on purpose (unlike local.env): it holds no org values, and it is what makes
# the engine runnable from a fresh clone with no tracker account, no host credentials,
# and no live board. Use it for the smoke test, for developing an engine script, and for
# reproducing a board state in a bug report.
#
#   MC_PROFILE=lib/mission-control/profiles/fixture.env ./lib/mission-control/mc-poll.sh
#
# Point MC_FIXTURES at your own data dir to reproduce a different board; the shape is
# documented at the top of adapters/tracker/fixture.sh and adapters/host/fixture.sh.

# --- providers ---
export MC_TRACKER="${MC_TRACKER:-fixture}"
export MC_HOST="${MC_HOST:-fixture}"

# Fixture data dir + the login the fixtures treat as "me".
export MC_FIXTURES="${MC_FIXTURES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../fixtures/example" && pwd)}"
export MC_FIXTURE_ME="${MC_FIXTURE_ME:-me}"

# The scratch board. NEVER the live state.json — every write script in the engine takes
# its target from MC_STATE, so pointing it here is what makes the harness safe.
export MC_STATE="${MC_STATE:-$MC_FIXTURES/state.json}"

# --- host (PR) config ---
export MC_REPOS="${MC_REPOS:-example-org/app}"
export MC_REVIEW_BOTS="${MC_REVIEW_BOTS:-github-actions dependabot codecov renovate}"
export MC_FREEZE_CHECK_PATTERN="${MC_FREEZE_CHECK_PATTERN:-freeze}"

# --- tracker config ---
export MC_READY_STATUS="${MC_READY_STATUS:-Ready for Dev}"
export MC_INBOUND_STATUS="${MC_INBOUND_STATUS:-$MC_READY_STATUS}"
export MC_POINTS_FIELD="${MC_POINTS_FIELD:-Story Points}"
export MC_TERMINAL_DONE="${MC_TERMINAL_DONE:-Done Closed Released Resolved}"
export MC_TICKET_KEY_REGEX="${MC_TICKET_KEY_REGEX:-[A-Z]+-[0-9]+}"
export MC_STATUS_RANK="${MC_STATUS_RANK:-Backlog=0;To Do=1;In Progress=2;In Review=3;QA=4;Done=5}"

# --- dash (renderer) config ---
export MC_TRACKER_LABEL="${MC_TRACKER_LABEL:-Tracker}"
export MC_HOST_LABEL="${MC_HOST_LABEL:-Host}"
# No TODAY overlay in the harness — the strip is a real-note lens, not board state.
export MC_DAILY_NOTE_FMT="${MC_DAILY_NOTE_FMT:-}"

# Runtime sidecars: keep every flag/lock inside the fixture dir so a harness run can
# never collide with the live loop's lock, heartbeat, or pause flag.
export MC_HEARTBEAT_FILE="${MC_HEARTBEAT_FILE:-$MC_FIXTURES/.loop-heartbeat}"
export MC_PAUSE_FILE="${MC_PAUSE_FILE:-$MC_FIXTURES/PAUSED}"
export MC_CODER_FILE="${MC_CODER_FILE:-$MC_FIXTURES/CODER_SPAWN_LIVE}"
export MC_INBOX="${MC_INBOX:-$MC_FIXTURES/mc-inbox}"
# MC_LOCK and MC_CYCLE_MARKER default to paths under ~/.claude/mission-control — the LIVE
# writer lock and the LIVE archive-rollover marker. Redirecting them is what stops a
# harness run from stealing the real loop's lock or rewriting its rollover marker.
export MC_LOCK="${MC_LOCK:-$MC_FIXTURES/.writer-lock}"
export MC_CYCLE_MARKER="${MC_CYCLE_MARKER:-$MC_FIXTURES/.last-archived-cycle}"
# state.archive.json is derived from MC_STATE so it already lands in the fixture dir;
# pinned anyway so every write target the harness can touch is visible in one place.
export MC_ARCHIVE="${MC_ARCHIVE:-$MC_FIXTURES/state.archive.json}"
# The login mc-review-check treats as self (its own comments are not incoming feedback).
export MC_REVIEW_SELF="${MC_REVIEW_SELF:-$MC_FIXTURE_ME}"
