# example.env — starter profile for a new org.
#
# Copy this to `local.env` in this dir — that file is gitignored, so your real values
# never reach the public repo — then fill in your tracker/host specifics. `dispatch.sh`
# sources the active profile (MC_PROFILE, default profiles/local.env) before any engine
# script runs.
#
# Every line uses `export VAR="${VAR:-…}"` on purpose: an explicit environment override
# still wins (a scratch harness, a one-off run), and the value is exported so the adapter
# subprocesses inherit it.

# --- providers (which adapter impl each dispatcher routes to) ---
export MC_TRACKER="${MC_TRACKER:-jira}"        # adapters/tracker/<name>.sh
export MC_HOST="${MC_HOST:-github}"            # adapters/host/<name>.sh

# --- host (PR) config ---
export MC_REPOS="${MC_REPOS:-your-org/repo-a your-org/repo-b}"   # space-separated watched repos
export MC_REVIEW_BOTS="${MC_REVIEW_BOTS:-github-actions dependabot codecov renovate}"  # review logins to ignore
export MC_FREEZE_CHECK_PATTERN="${MC_FREEZE_CHECK_PATTERN:-}"    # CI freeze-guard name substring; empty = no freeze concept

# --- tracker config ---
export MC_READY_STATUS="${MC_READY_STATUS:-Ready for Dev}"       # the "ready to start" status
export MC_INBOUND_STATUS="${MC_INBOUND_STATUS:-$MC_READY_STATUS}"  # alias mc-inbound reads
export MC_POINTS_FIELD="${MC_POINTS_FIELD:-Story Points}"        # vetting/estimate field (list_ready … vetted)
export MC_TERMINAL_DONE="${MC_TERMINAL_DONE:-Done Closed Released Resolved}"  # statuses meaning shipped
export MC_TICKET_KEY_REGEX="${MC_TICKET_KEY_REGEX:-[A-Z]+-[0-9]+}"  # ticket-key shape

# status → progress-rank map (mc-poll regression detection). `Status=rank` pairs,
# ';'-separated; integers on one workflow-progress scale (higher = further along).
export MC_STATUS_RANK="${MC_STATUS_RANK:-Backlog=0;To Do=1;In Progress=2;In Review=3;QA=4;Done=5}"

# --- dash (renderer) config ---
# Provider display labels for the dash health banner. Default = the adapter name with its
# first letter capitalized (jira → "Jira"); set these where the brand name differs.
export MC_TRACKER_LABEL="${MC_TRACKER_LABEL:-}"
export MC_HOST_LABEL="${MC_HOST_LABEL:-}"
# Daily-note path for the dash TODAY strip — the note whose "plan to accomplish today"
# section dash scrapes ticket keys from (read-only; never written). A strftime TEMPLATE,
# expanded on every render so the path tracks the date rollover. Empty = no TODAY
# overlay, which is the correct degrade if you keep no such note.
export MC_DAILY_NOTE_FMT="${MC_DAILY_NOTE_FMT:-}"
# MC_DAILY_NOTE overrides the template with a LITERAL path, for a spike or a test run.
# Leave it unset in a profile; the template above is the normal way to configure this.
export MC_DAILY_NOTE="${MC_DAILY_NOTE:-}"

# --- runner (where each WORKER role runs) ---
# `inprocess` = a subagent of the orchestrating session (today's behavior, no extra
# tooling). `herdr` = a visible pane running its own claude session (needs the herdr CLI
# and a workspace id below). Chosen per role, optionally per cycle: MC_RUNNER_<ROLE>_<CYCLE>
# wins over MC_RUNNER_<ROLE>. Cycles are `sprint` and `background`. An all-in-process org
# leaves every line at inprocess and never sees a pane.
export MC_RUNNER_PLANNER="${MC_RUNNER_PLANNER:-inprocess}"
export MC_RUNNER_PLANNER_SPRINT="${MC_RUNNER_PLANNER_SPRINT:-$MC_RUNNER_PLANNER}"
export MC_RUNNER_PLANNER_BACKGROUND="${MC_RUNNER_PLANNER_BACKGROUND:-$MC_RUNNER_PLANNER}"
export MC_RUNNER_CODER="${MC_RUNNER_CODER:-inprocess}"
export MC_RUNNER_REVIEWER="${MC_RUNNER_REVIEWER:-inprocess}"     # reviewers are always fresh; herdr adds nothing but a pane
export MC_RUNNER_INVESTIGATOR="${MC_RUNNER_INVESTIGATOR:-inprocess}"
# herdr specifics (ignored unless a role routes to herdr)
export MC_HERDR_WS_SPRINT="${MC_HERDR_WS_SPRINT:-}"          # `herdr workspace list` → workspace_id, e.g. w11
export MC_HERDR_WS_BACKGROUND="${MC_HERDR_WS_BACKGROUND:-}"  # empty = background tickets cannot use herdr
export MC_HERDR_SETTLE_S="${MC_HERDR_SETTLE_S:-20}"          # debounce after a pane looks settled
export MC_MODEL_PLANNER="${MC_MODEL_PLANNER:-}"              # claude --model value per role; empty = session default
export MC_MODEL_CODER="${MC_MODEL_CODER:-}"
export MC_MODEL_REVIEWER="${MC_MODEL_REVIEWER:-}"
