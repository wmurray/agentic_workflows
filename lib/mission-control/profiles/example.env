# example.env — starter profile for a new org.
#
# Copy this to `local.env` in this dir — that file is gitignored, so your real values
# never reach the public repo — then fill in your tracker/host specifics. `dispatch.sh`
# sources the active profile (MC_PROFILE, default profiles/local.env) before any engine
# script runs.
#
# Every line uses `export VAR="${VAR:-…}"` on purpose: an explicit environment override
# still wins (a scratch harness, a one-off run), and the value is exported so the adapter
# subprocesses inherit it.

# --- providers (which adapter impl each dispatcher routes to) ---
export MC_TRACKER="${MC_TRACKER:-jira}"        # adapters/tracker/<name>.sh
export MC_HOST="${MC_HOST:-github}"            # adapters/host/<name>.sh

# --- host (PR) config ---
export MC_REPOS="${MC_REPOS:-your-org/repo-a your-org/repo-b}"   # space-separated watched repos
export MC_REVIEW_BOTS="${MC_REVIEW_BOTS:-github-actions dependabot codecov renovate}"  # review logins to ignore
export MC_FREEZE_CHECK_PATTERN="${MC_FREEZE_CHECK_PATTERN:-}"    # CI freeze-guard name substring; empty = no freeze concept

# --- tracker config ---
export MC_READY_STATUS="${MC_READY_STATUS:-Ready for Dev}"       # the "ready to start" status
export MC_INBOUND_STATUS="${MC_INBOUND_STATUS:-$MC_READY_STATUS}"  # alias mc-inbound reads
export MC_POINTS_FIELD="${MC_POINTS_FIELD:-Story Points}"        # vetting/estimate field (list_ready … vetted)
export MC_TERMINAL_DONE="${MC_TERMINAL_DONE:-Done Closed Released Resolved}"  # statuses meaning shipped
export MC_TICKET_KEY_REGEX="${MC_TICKET_KEY_REGEX:-[A-Z]+-[0-9]+}"  # ticket-key shape

# status → progress-rank map (mc-poll regression detection). `Status=rank` pairs,
# ';'-separated; integers on one workflow-progress scale (higher = further along).
export MC_STATUS_RANK="${MC_STATUS_RANK:-Backlog=0;To Do=1;In Progress=2;In Review=3;QA=4;Done=5}"
